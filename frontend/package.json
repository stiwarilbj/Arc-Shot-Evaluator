{
  "name": "arc-shot-evaluator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:play-finder && tsc -b && vite build",
    "preview": "vite preview",
    "validate:play-finder": "node ../scripts/validate-play-finder-catalog.mjs",
    "test:play-finder": "node --experimental-strip-types ../scripts/test-play-finder.mjs",
    "test:playbook-geometry": "node --experimental-strip-types ../scripts/test-playbook-geometry.mjs",
    "test": "npm run test:play-finder && npm run test:playbook-geometry"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
