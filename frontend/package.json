{
  "name": "arc-shot-evaluator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:analysis-modes": "node --experimental-strip-types ../scripts/test-analysis-modes.mjs",
    "test:playbook-geometry": "node --experimental-strip-types ../scripts/test-playbook-geometry.mjs",
    "test:playbook-simulation": "node --experimental-strip-types ../scripts/test-playbook-simulation.mjs",
    "test:counter-lab": "node --experimental-strip-types ../scripts/test-counter-lab.mjs",
    "test": "npm run test:analysis-modes && npm run test:playbook-geometry && npm run test:playbook-simulation && npm run test:counter-lab && npm run test:counter-lab-requests && npm run test:counter-lab-boundaries && npm run test:counter-lab-replay-validation && npm run test:coordinated-movement && npm run test:playbook-performance && npm run test:playbook-draft-save && npm run test:playbook-document-validation && npm run test:playbook-precision && npm run test:playbook-save-results",
    "test:playbook-draft-save": "node --experimental-strip-types ../scripts/test-playbook-draft-save.mjs",
    "test:playbook-performance": "node --experimental-strip-types ../scripts/test-playbook-performance.mjs",
    "test:coordinated-movement": "node --experimental-strip-types ../scripts/test-coordinated-movement.mjs",
    "test:counter-lab-requests": "node --experimental-strip-types ../scripts/test-counter-lab-requests.mjs",
    "test:counter-lab-boundaries": "node --experimental-test-module-mocks --experimental-strip-types ../scripts/test-counter-lab-boundaries.mjs",
    "test:counter-lab-replay-validation": "node --experimental-strip-types ../scripts/test-counter-lab-replay-validation.mjs",
    "test:playbook-document-validation": "node --experimental-strip-types ../scripts/test-playbook-document-validation.mjs && node --experimental-strip-types ../scripts/test-playbook-persistence-validation.mjs",
    "test:playbook-precision": "node --experimental-strip-types ../scripts/test-playbook-precision.mjs",
    "test:playbook-save-results": "node --experimental-strip-types ../scripts/test-playbook-save-results.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
